{
  "name": "cura-nexus",
  "private": true,
  "version": "1.0.0",
  "description": "Cura Nexus — Unified Patient Record & Interoperability Platform (browser-first, FHIR R4)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:gh-pages": "cross-env VITE_BASE=/cura-nexus/ npm run build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "cross-env SCREENSHOTS=1 playwright test tests/e2e/screenshots.spec.ts",
    "samples": "tsx scripts/generate-samples.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.1.0",
    "@fontsource-variable/jetbrains-mono": "5.1.1",
    "@fontsource-variable/manrope": "5.1.0",
    "@hookform/resolvers": "3.9.1",
    "@supabase/supabase-js": "2.46.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "dexie": "4.0.10",
    "framer-motion": "11.11.17",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "react-router-dom": "6.28.0",
    "recharts": "2.13.3",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@playwright/test": "1.49.0",
    "@types/node": "22.9.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "cross-env": "7.0.3",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "fake-indexeddb": "6.0.0",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
